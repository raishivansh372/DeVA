name: Build DeVA APK

on:
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout source
        uses: actions/checkout@v4

      - name: Set up Java 17
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: "17"

      - name: Set up Android SDK
        uses: android-actions/setup-android@v3

      - name: Install Android SDK components
        run: |
          yes | sdkmanager --licenses || true
          sdkmanager "platforms;android-35" "build-tools;35.0.0"

      - name: Create local.properties
        run: |
          cat > local.properties <<'EOF'
          GEMINI_API_KEYS=
          TAVILY_API=
          MEM0_API=
          PICOVOICE_ACCESS_KEY=
          GOOGLE_TTS_API_KEY=
          GCLOUD_GATEWAY_PICOVOICE_KEY=
          GCLOUD_GATEWAY_URL=
          GCLOUD_PROXY_URL=
          GCLOUD_PROXY_URL_KEY=
          REVENUE_CAT_PUBLIC_URL=
          REVENUECAT_API_KEY=
          EOF

      - name: Create Firebase configuration for build
        run: |
          cat > app/google-services.json <<'EOF'
          {
            "project_info": {
              "project_number": "123456789",
              "project_id": "deva-build",
              "storage_bucket": "deva-build.appspot.com"
            },
            "client": [
              {
                "client_info": {
                  "mobilesdk_app_id": "1:123456789:android:0000000000000000",
                  "android_client_info": {
                    "package_name": "com.deva.voice"
                  }
                },
                "api_key": [
                  {
                    "current_key": "AIzaSyDummyBuildKey"
                  }
                ],
                "services": {
                  "appinvite_service": {
                    "other_platform_oauth_client": []
                  }
                }
              }
            ]
          }
          EOF

      - name: Make Gradle executable
        run: chmod +x ./gradlew

      - name: Build debug APK
        run: ./gradlew :app:assembleDebug --stacktrace

      - name: Upload APK
        uses: actions/upload-artifact@v4
        with:
          name: DeVA-debug
          path: app/build/outputs/apk/debug/app-debug.apk
